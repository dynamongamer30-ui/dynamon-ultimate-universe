    "ALLOWED_ORIGINS": "http://localhost:8080,http://127.0.0.1:8080,http://localhost:5174,http://127.0.0.1:5174"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "29e01df227224591a5220b0f5e5d721e"
    }
  ]
}
