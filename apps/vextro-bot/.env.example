# Never commit a real .env file or paste secrets into chat.
BOT_TOKEN=
OWNER_TELEGRAM_ID=
SUPABASE_URL=https://dfxcpxzylyycrirtnkof.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
WEBSITE_URL=
REQUIRED_CHANNEL_ID=
# Numeric Telegram group chat ID (usually starts with -100).
REQUIRED_GROUP_ID=
# Optional: channel ID or @username used by Owner post publishing
# PUBLISH_CHANNEL_ID=@your_channel
BOT_PUBLIC_USERNAME=
LOG_LEVEL=info

# Encrypts application-data backups; use a unique secret with at least 16 characters.
BACKUP_PASSPHRASE=
BACKUP_BUCKET=vextro-backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# Optional release/deployment integration. Deployment requires a host webhook.
GITHUB_REPOSITORY=dynamongamer30-ui/dynamon-ultimate-universe
DEPLOY_WEBHOOK_URL=
DEPLOY_WEBHOOK_SECRET=
UPDATE_CHECK_INTERVAL_HOURS=6

# Optional offsite HTTPS endpoint must accept encrypted bytes and return JSON {"sha256":"<matching hash>"}.
BACKUP_OFFSITE_URL=
BACKUP_OFFSITE_TOKEN=

# All scheduled posts and broadcasts interpret local input in this IANA timezone.
OWNER_TIMEZONE=Asia/Kolkata
