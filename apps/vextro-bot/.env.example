# Non-secret defaults for the existing VEXTRO Telegram deployment.
# Add BOT_TOKEN and SUPABASE_SERVICE_ROLE_KEY privately in KataBump environment settings.
BOT_TOKEN=
BOT_PUBLIC_USERNAME=DYNAMONHELPERBOT
OWNER_TELEGRAM_ID=1970192536

# Existing Telegram membership requirements
REQUIRED_CHANNEL_ID=-1003934201623
REQUIRED_CHANNEL_URL=https://t.me/dynamongamer
REQUIRED_GROUP_ID=-1004371276942
REQUIRED_GROUP_URL=https://t.me/+ShksG2YhoRJkNzg1

# Existing website + Supabase project
WEBSITE_URL=https://dynamongamer.com
SUPABASE_URL=https://dfxcpxzylyycrirtnkof.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional channel publishing (set to the channel chat ID or @username)
PUBLISH_CHANNEL_ID=

# Encrypted backups: configure a unique passphrase of at least 16 characters.
# Keep it private and store a separate copy in a password manager.
BACKUP_PASSPHRASE=
BACKUP_BUCKET=vextro-backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# Optional offsite backup endpoint; both values must be set together.
BACKUP_OFFSITE_URL=
BACKUP_OFFSITE_TOKEN=

# Optional update/deployment integration; webhook requires a host-side endpoint.
GITHUB_REPOSITORY=dynamongamer30-ui/dynamon-ultimate-universe
DEPLOY_WEBHOOK_URL=
DEPLOY_WEBHOOK_SECRET=
UPDATE_CHECK_INTERVAL_HOURS=6

# Scheduled posts and broadcasts use the Owner's timezone.
OWNER_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info
